# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# YAML is whitespace-sensitive and conventionally 2-space (CI configs).
[*.{yml,yaml}]
indent_size = 2

# Markdown uses two trailing spaces as a hard line break.
[*.md]
trim_trailing_whitespace = false

# Make requires literal tabs in recipe lines.
[{Makefile,*.mk}]
indent_style = tab

# SystemVerilog: 2-space is the dominant convention (lowRISC, Google styles).
[*.{v,sv,svh}]
indent_size = 2

# Vendored code keeps its upstream formatting - never reformat on save.
[third_party/**]
trim_trailing_whitespace = false
insert_final_newline = false
indent_style = unset
indent_size = unset
